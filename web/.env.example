# LOCAL DEVELOPMENT ONLY. Copy to .env.local and keep it out of Git.
RELAY_ENV=development
RELAY_DB_HOST=127.0.0.1
RELAY_DB_PORT=5434
RELAY_DB_NAME=relay
RELAY_DB_USER=relay
RELAY_DB_PASSWORD=relay-local-only
RELAY_N8N_DB_PASSWORD=relay-n8n-reader-local-only
REDIS_URL=redis://127.0.0.1:6380
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000
N8N_WEBHOOK_URL=http://127.0.0.1:5679/webhook/relay-classify
N8N_WEBHOOK_SECRET=relay-local-webhook-secret-not-for-production
RELAY_POLL_MS=5000
RELAY_MAX_ATTEMPTS=8
GHL_MODE=mock
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TRUST_CLOUDFLARE=false
