# Copy to .env and replace placeholders. Never commit .env.
DOMINIO=tudominio.com
ADMIN_IP=1.2.3.4
RELAY_ENV=staging
RELAY_DB_PASSWORD=
RELAY_N8N_DB_PASSWORD=
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
# Generate distinct random values (at least 32 bytes).
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_SECRET=
N8N_VERSION=2.42.5
RELAY_POLL_MS=5000
RELAY_MAX_ATTEMPTS=8
# GHL token must support contacts.read and contacts.write.
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
# Required when RELAY_ENV=production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set true only when the origin firewall accepts web traffic exclusively from Cloudflare.
TRUST_CLOUDFLARE=true
