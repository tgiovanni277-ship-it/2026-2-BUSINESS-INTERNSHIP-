# LOCAL TESTS ONLY. Copy to .env.dev; never use these values in staging/production.
DOMINIO=localhost
ADMIN_IP=127.0.0.1
RELAY_ENV=development
RELAY_DB_PASSWORD=relay-local-only
RELAY_N8N_DB_PASSWORD=relay-n8n-reader-local-only
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n-local-only
N8N_ENCRYPTION_KEY=relay-local-encryption-key-not-for-production-000000
N8N_WEBHOOK_SECRET=relay-local-webhook-secret-not-for-production
N8N_VERSION=2.42.5
RELAY_POLL_MS=5000
RELAY_MAX_ATTEMPTS=8
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
# Leave blank locally. Production must configure both values from Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TRUST_CLOUDFLARE=false
